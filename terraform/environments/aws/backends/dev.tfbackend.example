# AWS Terraform Backend Configuration - Development
# CI does not use this file: it builds its backend from the TF_BACKEND_AWS secret.
# Copy to dev.tfbackend and customize with your values
#
# Usage:
#   cp backends/dev.tfbackend.example backends/dev.tfbackend
#   # Edit dev.tfbackend with your values, then:
#   terraform init -backend-config=backends/dev.tfbackend

bucket         = "your-cudly-terraform-state-aws-dev"
key            = "github-dev/terraform.tfstate"
region         = "us-east-1"
encrypt        = true
use_lockfile   = true
# profile      = "your-aws-profile"  # Optional: AWS CLI profile

# Note: Create the S3 bucket before first use:
#   aws s3 mb s3://your-cudly-terraform-state-aws-dev --region us-east-1
#   aws s3api put-bucket-versioning --bucket your-cudly-terraform-state-aws-dev --versioning-configuration Status=Enabled
