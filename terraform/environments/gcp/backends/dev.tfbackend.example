# GCP Terraform Backend Configuration - Development
# Copy to dev.tfbackend and customize with your values
#
# Usage:
#   cp backends/dev.tfbackend.example backends/dev.tfbackend
#   # Edit dev.tfbackend with your values, then:
#   terraform init -backend-config=backends/dev.tfbackend

bucket = "your-cudly-terraform-state-gcp-dev"
prefix = "dev"

# Note: Create the GCS bucket before first use:
#   gsutil mb -p YOUR_PROJECT_ID -l US gs://your-cudly-terraform-state-gcp-dev
#   gsutil versioning set on gs://your-cudly-terraform-state-gcp-dev
